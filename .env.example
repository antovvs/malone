# Copier ce fichier en .env.local puis renseigner les valeurs.
# Ne jamais versionner .env.local : il contient des secrets.

# --- Auth -------------------------------------------------------------
# Secret qui signe les sessions (JWT). Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
# Adresse publique du site. Inutile en local et sur Vercel (détectée automatiquement) ;
# à définir seulement derrière un proxy qui masque le vrai nom de domaine.
# NEXTAUTH_URL=https://malone.example.com
# Durée de session en heures (24 par défaut).
# SESSION_MAX_AGE_HOURS=24

# --- Comptes ----------------------------------------------------------
# Un bloc par personne. USER_n_HASH est le hash bcrypt du mot de passe,
# généré par :  npm run hash-password   (le mot de passe n'est jamais écrit ici)
# (Le dépôt étant public, les vrais identifiants ne figurent pas ici : ils sont dans .env.local.)
USER_1_ID=
USER_1_HASH=
USER_1_NAME=
USER_1_ROLE=manager

USER_2_ID=
USER_2_HASH=
USER_2_NAME=
USER_2_ROLE=admin

# --- MyFeed API -------------------------------------------------------
# Clé API MyFeed de l'agence. Reste sur le serveur, jamais envoyée au navigateur.
MYFEED_API_KEY=
# Serveur MCP de MyFeed (JSON-RPC « tools/call », clé en Bearer).
MYFEED_API_URL=https://myfeed.fans/mcp
# mcp (défaut) ou rest.
MYFEED_API_MODE=mcp
# 1 = données fictives quand MYFEED_API_KEY est vide (un badge « Données de démo » s'affiche).
MYFEED_DEMO=0
